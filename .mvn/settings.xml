<settings
  xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <activeProfiles>
    <activeProfile>valstro-auth</activeProfile>
  </activeProfiles>
  <mirrors>
    <mirror>
      <id>codeartifact</id>
      <name>valstro-maven-internal</name>
      <url>https://valstro-194722423205.d.codeartifact.us-east-2.amazonaws.com/maven/maven-internal/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>valstro-auth</id>
      <properties>
        <maven.wagon.httpconnectionManager.ttlSeconds>120</maven.wagon.httpconnectionManager.ttlSeconds>
        <maven.wagon.http.retryHandler.count>3</maven.wagon.http.retryHandler.count>
        <maven.wagon.rto>60000</maven.wagon.rto>
        <maven.wagon.http.connectionTimeout>60000</maven.wagon.http.connectionTimeout>
        <maven.wagon.http.readTimeout>60000</maven.wagon.http.readTimeout>
      </properties>
      <repositories>
        <repository>
          <id>codeartifact</id>
          <url>https://valstro-194722423205.d.codeartifact.us-east-2.amazonaws.com/maven/maven-internal/</url>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <servers>
    <server>
      <id>codeartifact</id>
      <username>aws</username>
      <password>${env.CODEARTIFACT_AUTH_TOKEN}</password>
    </server>
  </servers>
</settings>
